{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "check-types": "next typegen && tsc --noEmit",
    "schema:shop": "(cd ../server && npx vendure schema --api shop --dir ../storefront --file-name schema-shop.graphql --format sdl < /dev/null) && gql.tada generate-output"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
