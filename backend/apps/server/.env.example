# Vendure server environment variables.
# Copy to `.env` and fill in real values. Do NOT commit `.env`.
# VENDURE_ROLE (server|worker) is set by the npm run scripts, not here.

# App environment. `dev` enables debug, local asset storage, and DB synchronize.
# Use anything else (e.g. `prod`) in staging/production.
APP_ENV=dev

# Port the server listens on (defaults to 3000).
PORT=3000

# Secret used to sign auth/session cookies. Generate a long random string,
# e.g.: openssl rand -base64 32
COOKIE_SECRET=your-secure-random-string-here

# Superadmin credentials for the admin dashboard.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me

# PostgreSQL connection.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendure
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_SCHEMA=public

# Base URL of the Next.js storefront, used to build links in transactional
# emails (password reset, etc.). Defaults to http://localhost:3001 in dev.
# REQUIRED when APP_ENV is not `dev` — the server refuses to boot without it.
STOREFRONT_URL=http://localhost:3001

# --- Production asset storage (Cloudflare R2 / S3-compatible) ---
# Only used when APP_ENV is not `dev`. In dev, assets are stored locally and
# these can be left unset. All four S3_* below are required in production.
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true

# Public URL prefix assets are served from in production (must match your R2/CDN
# domain). Guessed automatically in dev; usually must be set in production.
# ASSET_URL_PREFIX=
